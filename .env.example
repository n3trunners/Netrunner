# NetRunner uses Bring Your Own Token (BYOK) for AI inference.
# Users enter their own Gemini or OpenAI-compatible API key inside Settings > Models.
# No free server-side GEMINI_API_KEY is required or shared.

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET for GitHub OAuth
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
