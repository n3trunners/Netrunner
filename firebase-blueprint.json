{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "githubUsername": { "type": "string", "maxLength": 128 },
        "bio": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName"]
    },
    "Project": {
      "title": "Project",
      "description": "User created projects in workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 64 },
        "tags": { "type": "array" },
        "status": { "type": "string", "maxLength": 32 },
        "filesCount": { "type": "number" },
        "repoUrl": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents indexed by Auth UID"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects subcollection"
    }
  }
}
